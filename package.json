{
  "name": "cardgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-registry.mjs && node scripts/gen-icons.mjs",
    "gen:font": "node scripts/gen-display-font.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "prebuild": "npm run gen",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run build && vite build --mode single --outDir dist-single && node scripts/build-single.mjs",
    "prebuild:server": "npm run gen",
    "build:server": "node scripts/build-server.mjs",
    "presim": "npm run gen",
    "sim": "node scripts/sim/run-all.mts",
    "presim:presets": "npm run gen",
    "sim:presets": "node scripts/sim/presets.mts",
    "preview": "vite preview",
    "sim:options": "node scripts/sim/options.mts",
    "predev:server": "npm run gen",
    "dev:server": "node scripts/dev-online-server.mts"
  },
  "dependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@supabase/realtime-js": "2.117.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
