{
  "name": "cardgame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-registry.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "pretest": "npm run gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "prebuild": "npm run gen",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "prebuild:server": "npm run gen",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
