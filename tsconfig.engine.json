{
  "//": "ルールエンジンとサーバー処理（と両方が読む公式カード・プリセットデッキ）が DOM やブラウザ API に依存していないことを型チェックで保証する",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/engine", "src/online", "src/official", "src/presets.ts"]
}
